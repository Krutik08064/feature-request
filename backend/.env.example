# ==============================================================================
# ComBot Backend Environment Configuration
# ==============================================================================

# Application Environment: 'development' or 'production'
ENVIRONMENT=development

# Server Host & Port
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (comma-separated)
# In development: http://localhost:5173,http://127.0.0.1:5173
# In production: https://your-frontend-domain.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MongoDB Connection
# Local development: mongodb://localhost:27017
# Production Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=combot_db

# Security & JWT Secrets (Change these in production! Generate with: openssl rand -hex 32)
JWT_SECRET_KEY=your_super_secret_jwt_key_minimum_32_characters_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie Settings
# Set COOKIE_SECURE=false for local HTTP testing, true for HTTPS deployment
COOKIE_SECURE=false
# SameSite: 'lax' (standard/same-origin) or 'none' (required for cross-domain deployment, e.g. Vercel frontend + Render backend)
COOKIE_SAMESITE=lax
# Optional cookie domain for subdomains (e.g. .yourdomain.com). Leave empty for default.
COOKIE_DOMAIN=

# Simulated Email / Dev Mode Token Endpoint
# When True, verification and password reset tokens are logged to server console
# and accessible via GET /api/auth/dev-tokens for automated testing and previewing.
ENABLE_DEV_TOKENS=true
